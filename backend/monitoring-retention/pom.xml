<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.monitoring</groupId>
        <artifactId>cloud-monitoring-platform</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>monitoring-retention</artifactId>

    <dependencies>
        <!-- Tenant context, organizations and role checks. -->
        <dependency>
            <groupId>com.monitoring</groupId>
            <artifactId>monitoring-auth</artifactId>
        </dependency>

        <!-- Applications map an organization to the rows it owns in telemetry tables. -->
        <dependency>
            <groupId>com.monitoring</groupId>
            <artifactId>monitoring-apps-management</artifactId>
        </dependency>

        <!-- Telemetry entities and repositories (logs, metrics, traces). -->
        <dependency>
            <groupId>com.monitoring</groupId>
            <artifactId>monitoring-collector</artifactId>
        </dependency>

        <!-- @AuditLog annotation and aspect for policy changes. -->
        <dependency>
            <groupId>com.monitoring</groupId>
            <artifactId>monitoring-audit</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Micrometer API for the retention_rows_deleted_total counter. -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-core</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
