<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.monitoring</groupId>
        <artifactId>cloud-monitoring-platform</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>monitoring-api</artifactId>

    <dependencies>
        <!-- Shared PageResponse / ApiError DTOs. -->
        <dependency>
            <groupId>com.monitoring</groupId>
            <artifactId>monitoring-common</artifactId>
        </dependency>

        <!-- Application management module -->
        <dependency>
            <groupId>com.monitoring</groupId>
            <artifactId>monitoring-apps-management</artifactId>
        </dependency>

        <!-- Metrics ingestion module -->
        <dependency>
            <groupId>com.monitoring</groupId>
            <artifactId>monitoring-collector</artifactId>
        </dependency>

        <!-- Dashboards module -->
        <dependency>
            <groupId>com.monitoring</groupId>
            <artifactId>monitoring-dashboards</artifactId>
        </dependency>

        <!-- Health checks module -->
        <dependency>
            <groupId>com.monitoring</groupId>
            <artifactId>monitoring-healthcheck</artifactId>
        </dependency>

        <!-- Alerts module -->
        <dependency>
            <groupId>com.monitoring</groupId>
            <artifactId>monitoring-alerts</artifactId>
        </dependency>

        <!-- Audit logging module -->
        <dependency>
            <groupId>com.monitoring</groupId>
            <artifactId>monitoring-audit</artifactId>
        </dependency>

        <!-- Auth module -->
        <dependency>
            <groupId>com.monitoring</groupId>
            <artifactId>monitoring-auth</artifactId>
        </dependency>

        <!-- Spring Data JPA -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Validation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- MySQL Connector -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- H2 (tests / local development) -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Spring Boot Actuator -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Prometheus registry: exposes JVM, HTTP, Tomcat and HikariCP metrics. -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!-- Flyway: single source of truth for the DB schema (migrations in module db/migration dirs) -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>

        <!-- OpenAPI / Swagger UI (documentation and interactive endpoint explorer) -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- DevTools -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>