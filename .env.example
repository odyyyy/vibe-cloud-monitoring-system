# =============================================================================
# VibeMonitoring local / production-like stack configuration
# =============================================================================
# Copy this file to .env and replace every placeholder before exposing the stack:
#   cp .env.example .env
#
# .env is ignored by git. Never commit real credentials, tokens or private keys.
# The values below are safe defaults for local development only. The backend runs
# without the "prod" profile by default; with SPRING_PROFILES_ACTIVE=prod a missing,
# weak or example JWT_SECRET makes startup fail on purpose.
#
# Generate strong secrets with:
#   openssl rand -base64 48
# =============================================================================

# --- Compose ports -----------------------------------------------------------
# Frontend is served by nginx (same origin also proxies /api to the backend).
FRONTEND_PORT=3000
BACKEND_PORT=8080
# Only used by compose.dev.yaml (the production-style compose.yaml does not publish MySQL).
MYSQL_PORT=3306

# --- Frontend runtime --------------------------------------------------------
# Upstream used by nginx to proxy /api inside the Compose network. Override only when
# the backend is reachable under a different hostname/port; no image rebuild is needed.
BACKEND_URL=http://backend:8080

# --- MySQL -------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=vibemonitoring-local-root-password
MYSQL_DATABASE=monitoring_db
MYSQL_USER=monitoring
MYSQL_PASSWORD=vibemonitoring-local-db-password

# --- Backend database connection --------------------------------------------
# Keep the username/password in sync with MYSQL_USER / MYSQL_PASSWORD above.
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/monitoring_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8
SPRING_DATASOURCE_USERNAME=monitoring
SPRING_DATASOURCE_PASSWORD=vibemonitoring-local-db-password
SPRING_DATASOURCE_DRIVER_CLASS_NAME=com.mysql.cj.jdbc.Driver
# Flyway owns the schema; Hibernate only validates it.
SPRING_JPA_HIBERNATE_DDL_AUTO=validate

# Leave blank for the production-like local stack. Set to "prod" only after replacing
# JWT_SECRET with a real random value.
SPRING_PROFILES_ACTIVE=

# --- JWT ---------------------------------------------------------------------
# Mandatory, at least 32 bytes. The example value below is rejected when the prod
# profile is active, so production cannot silently use it.
JWT_SECRET=vibemonitoring-local-development-jwt-secret-change-me
JWT_EXPIRATION=86400000

# --- Authentication links and email -----------------------------------------
# Local quick start writes verification/reset links to the backend log:
#   docker compose logs backend | grep -i "http://localhost:3000"
# Set to false in production and configure a real email sender.
APP_AUTH_LOG_EMAILS=true
APP_AUTH_VERIFICATION_URL=http://localhost:3000/verify-email
APP_AUTH_RESET_URL=http://localhost:3000/reset-password
APP_AUTH_EMAIL_CHANGE_URL=http://localhost:3000/confirm-email-change
APP_AUTH_VERIFICATION_TTL=PT24H
APP_AUTH_RESET_TTL=PT1H
APP_AUTH_EMAIL_CHANGE_TTL=PT1H
APP_AUTH_LOGIN_PROTECTION_ENABLED=true

# --- SSO / OpenID Connect (optional, disabled by default) --------------------
# When enabled, issuer must use HTTPS (http is accepted only for a localhost issuer).
APP_SSO_ENABLED=false
APP_SSO_REGISTRATION_ID=sso
APP_SSO_ISSUER_URI=
APP_SSO_CLIENT_ID=
APP_SSO_CLIENT_SECRET=
APP_SSO_ROLE_CLAIM=groups
APP_SSO_DEFAULT_ROLE=VIEWER
APP_SSO_SUCCESS_REDIRECT_URL=http://localhost:3000/sso/callback
APP_SSO_FAILURE_REDIRECT_URL=http://localhost:3000/login

# --- Platform administration -------------------------------------------------
# Username promoted to PLATFORM_ADMIN on startup and re-checked periodically.
# Leave blank to disable. Register the account first, then set this value and restart
# the backend (or wait for the sync interval).
MONITORING_PLATFORM_ADMIN_USERNAME=
MONITORING_PLATFORM_ADMIN_SYNC_INTERVAL_MS=300000

# --- Platform telemetry / local limits --------------------------------------
MONITORING_PLATFORM_METRICS_ENABLED=true
MONITORING_QUOTAS_ENABLED=true
MONITORING_QUOTAS_METRICS_PER_MINUTE=10000
MONITORING_QUOTAS_LOGS_PER_MINUTE=5000
# Smaller quotas make the usage meters readable with sample data.
MONITORING_USAGE_METRICS_QUOTA=100000
MONITORING_USAGE_LOGS_QUOTA=50000
MONITORING_USAGE_TRACES_QUOTA=10000
MONITORING_ALERTS_FRONTEND_BASE_URL=http://localhost:3000

# --- Go agent (optional "agent" Compose profile) ----------------------------
# Create an Application in the UI, copy its one-time API key and put it here.
# Never commit the real key.
AGENT_API_KEY=
AGENT_INTERVAL_SECONDS=15

# --- Database backup/restore scripts ----------------------------------------
# scripts/backup-db.sh and scripts/restore-db.sh load this file automatically.
# By default they run mysqldump/mysql inside the running Compose "mysql" service.
# Set DB_HOST to use a local client against an externally reachable database.
# DB_HOST=127.0.0.1
# DB_PORT=3306
DB_NAME=monitoring_db
DB_USER=monitoring
DB_PASSWORD=vibemonitoring-local-db-password

# No separate application-level encryption key exists in the current release. The JWT
# secret is the only signing key; application API keys are stored as SHA-256 hashes.
